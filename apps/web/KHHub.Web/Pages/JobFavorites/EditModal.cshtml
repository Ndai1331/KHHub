@page
@using Microsoft.AspNetCore.Mvc.Localization
@using KHHub.MasterDataService.Localization
@using KHHub.Web.Pages.JobFavorites
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@using KHHub.MasterDataService.Services.JobFavorites; 
@using System.Globalization
@inject IHtmlLocalizer<MasterDataServiceResource> L
@model EditModalModel
@{
    Layout = null;
}
<form data-ajaxForm="true" asp-page="/JobFavorites/EditModal" autocomplete="off">
    <abp-modal id="JobFavoriteEditModal">
        <abp-modal-header title="@L["Update"].Value"></abp-modal-header>
        <abp-modal-body>
@*//<suite-custom-code-block-1>*@
@*//</suite-custom-code-block-1>*@
            <abp-input asp-for="Id" />
                    <abp-input asp-for="JobFavorite.ConcurrencyStamp" hidden="true" suppress-label="true"/>
            <abp-input asp-for="JobFavorite.UserId"    />
                                <div class="form-group">
                <label for="JobFavorite_JobId">@L["Job"]</label>
                <select id="JobFavorite_JobId"
                         name="JobFavorite.JobId"
                         class="custom-select form-control"
                         data-value="@Model.JobFavorite.JobId" required>
                    @if (Model.Job != null)
                    {
                        <option value="@Model.JobFavorite.JobId">@Model.Job.Title</option>
                    }
                </select>
            </div>
@*//<suite-custom-code-block-2>*@
@*//</suite-custom-code-block-2>*@
@*//<suite-custom-code-block-3>*@
@*//</suite-custom-code-block-3>*@
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel|AbpModalButtons.Save)">
@*//<suite-custom-code-block-4>*@
@*//</suite-custom-code-block-4>*@
        </abp-modal-footer>
    </abp-modal>
</form>