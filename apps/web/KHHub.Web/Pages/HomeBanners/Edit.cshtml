@page
@using KHHub.MasterDataService.Localization
@using KHHub.Web.Media
@using KHHub.Web.Navigation
@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@inject IHtmlLocalizer<MasterDataServiceResource> L
@inject IPageLayout PageLayout
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@model KHHub.Web.Pages.HomeBanners.EditModel
@{
    PageLayout.Content.Title = L["EditHomeBanner"].Value;
    PageLayout.Content.MenuItemName = KHHubMenus.HomeBanners;
    var imagePreviewClass = string.IsNullOrEmpty(Model.HomeBanner.ImageUrl) ? "d-none" : "";
    var mobilePreviewClass = string.IsNullOrEmpty(Model.HomeBanner.MobileImageUrl) ? "d-none" : "";
}

@section styles
{
    <link rel="stylesheet" href="~/Pages/MediaFiles/media-explorer.css" asp-append-version="true" />
    <style>
        .khhub-home-banner-form .khhub-upload-dropzone {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 170px;
            border: 1px dashed #dee2e6;
            border-radius: 12px;
            background-color: #f8fafc;
            color: #6c757d;
            cursor: pointer;
            text-align: center;
            padding: 16px;
        }

        .khhub-home-banner-form .khhub-upload-dropzone:hover {
            border-color: #3B82F6;
            color: #3B82F6;
            background-color: #f1f7ff;
        }
    </style>
}

@section scripts
{
    <partial name="~/Pages/Shared/_MediaPreviewSettings.cshtml" />
    <script src="~/Pages/Shared/khhub-media-preview.js" asp-append-version="true"></script>
    <abp-script src="/Pages/Articles/article-media-upload.js" />
    <abp-script src="/Pages/HomeBanners/home-banner-form-save.js" />
    <abp-script src="/Pages/MediaFiles/index.js" />
    <abp-script src="/Pages/Shared/media-library-picker.js" />
}

@section content_toolbar
{
    <a asp-page="./Index" class="btn btn-secondary"><i class="fa fa-arrow-left me-1"></i>@L["BackToList"].Value</a>
    @if (Model.CanDelete)
    {
        <abp-button id="DeleteHomeBannerButton" button-type="Danger" text="@L["DeleteHomeBanner"].Value" icon="trash" />
    }
    <abp-button id="SaveHomeBannerButton" button-type="Primary" text="@L["Save"].Value" icon="save" form="HomeBannerEditForm" type="submit" />
}

<p class="text-muted mb-4">@L["HomeBannerFormLayoutHint"].Value</p>

<form id="HomeBannerEditForm" method="post" autocomplete="off" data-home-banner-mode="edit">
    @Html.AntiForgeryToken()
    <abp-input asp-for="Id" type="hidden" />
    <div asp-validation-summary="All" class="text-danger mb-2"></div>
    <abp-card class="mb-4 khhub-home-banner-form">
        <abp-card-header class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h5 class="mb-0">@L["HomeBannerInformation"].Value</h5>
            @if (Model.LastUpdatedAt.HasValue)
            {
                <span class="text-muted small">@L["LastModificationTime"]: @Model.LastUpdatedAt.Value.ToString("g")</span>
            }
        </abp-card-header>
        <abp-card-body>
            <abp-input asp-for="HomeBanner.ConcurrencyStamp" type="hidden" />
            <abp-input asp-for="HomeBanner.Title" label="@L["Title"].Value" />
            <abp-input asp-for="HomeBanner.Subtitle" label="Sort Title (tiêu đề phụ / tagline)" />

            <abp-row class="g-3 mb-3">
                <abp-column size-md="_6">
                    <label class="form-label">Hình ảnh desktop 1920×600px, tối đa 3MB</label>
                    <div class="d-flex flex-wrap gap-2 mb-2">
                        <button type="button" class="btn btn-outline-primary btn-sm rounded-2 khhub-media-library-open"
                                data-url-target="#HomeBannerImageUrl" data-preview-target="#HomeBannerImagePreview">
                            <i class="fa fa-picture-o me-1" aria-hidden="true"></i>@L["MediaLibrary:ChooseFromLibrary"].Value
                        </button>
                    </div>
                    <label for="HomeBannerDesktopUploadInput" class="khhub-upload-dropzone mb-2">
                        <i class="fa fa-picture-o fa-2x" aria-hidden="true"></i>
                        <strong>Click để chọn ảnh</strong>
                        <span>Desktop 1920×600</span>
                    </label>
                    <input id="HomeBannerDesktopUploadInput"
                           type="file"
                           class="article-media-upload d-none"
                           accept="image/*"
                           data-upload-url="HomeBanners/MediaUpload"
                           data-url-target="#HomeBannerImageUrl"
                           data-preview-target="#HomeBannerImagePreview" />
                    <img id="HomeBannerImagePreview" alt="@L["ImagePreview"]" class="img-fluid rounded border mb-2 @imagePreviewClass" style="max-height: 200px;" src="@MediaPreviewUrl.ResolveReadUrl(Model.HomeBanner.ImageUrl, Configuration["MediaFilesStorage:PublicBaseUrl"])" />
                    <abp-input asp-for="HomeBanner.ImageUrl" id="HomeBannerImageUrl" label="Hoặc nhập URL ảnh..." />
                    <span asp-validation-for="HomeBanner.ImageUrl" class="text-danger d-block"></span>
                </abp-column>

                <abp-column size-md="_6">
                    <label class="form-label">Hình ảnh mobile 640×480px, tối đa 2MB</label>
                    <div class="d-flex flex-wrap gap-2 mb-2">
                        <button type="button" class="btn btn-outline-primary btn-sm rounded-2 khhub-media-library-open"
                                data-url-target="#HomeBannerMobileImageUrl" data-preview-target="#HomeBannerMobileImagePreview">
                            <i class="fa fa-picture-o me-1" aria-hidden="true"></i>@L["MediaLibrary:ChooseFromLibrary"].Value
                        </button>
                    </div>
                    <label for="HomeBannerMobileUploadInput" class="khhub-upload-dropzone mb-2">
                        <i class="fa fa-mobile fa-2x" aria-hidden="true"></i>
                        <strong>Click để chọn ảnh</strong>
                        <span>Mobile 640×480</span>
                    </label>
                    <input id="HomeBannerMobileUploadInput"
                           type="file"
                           class="article-media-upload d-none"
                           accept="image/*"
                           data-upload-url="HomeBanners/MediaUpload"
                           data-url-target="#HomeBannerMobileImageUrl"
                           data-preview-target="#HomeBannerMobileImagePreview" />
                    <img id="HomeBannerMobileImagePreview" alt="@L["ImagePreview"]" class="img-fluid rounded border mb-2 @mobilePreviewClass" style="max-height: 200px;" src="@MediaPreviewUrl.ResolveReadUrl(Model.HomeBanner.MobileImageUrl, Configuration["MediaFilesStorage:PublicBaseUrl"])" />
                    <abp-input asp-for="HomeBanner.MobileImageUrl" id="HomeBannerMobileImageUrl" label="Hoặc nhập URL ảnh..." />
                </abp-column>
            </abp-row>

            <abp-row class="g-3 mb-2">
                <abp-column size-md="_6">
                    <abp-input asp-for="HomeBanner.ButtonText" label="Nội dung nút (ButtonText)" />
                </abp-column>
                <abp-column size-md="_6">
                    <abp-input asp-for="HomeBanner.ButtonUrl" label="Link nút" />
                </abp-column>
            </abp-row>

            <abp-row class="g-3 mb-2">
                <abp-column size-md="_6">
                    <abp-input asp-for="HomeBanner.SortOrder" label="Thứ tự hiển thị" />
                </abp-column>
                <abp-column size-md="_6">
                    <abp-input asp-for="HomeBanner.IsActive" label="Hiển thị trên website" />
                </abp-column>
            </abp-row>

            <abp-row class="g-3 mb-2">
                <abp-column size-md="_6">
                    <abp-select asp-for="HomeBanner.TargetType" asp-items="@Model.TargetTypeList" label="@L["TargetType"].Value" />
                </abp-column>
                <abp-column size-md="_6">
                    <abp-input asp-for="HomeBanner.TargetId" label="@L["TargetId"].Value" />
                </abp-column>
            </abp-row>

            <abp-row class="g-3 mb-0">
                <abp-column size-md="_6">
                    <abp-date-picker auto-update-input="true" today-button-classes="btn-primary" asp-for="HomeBanner.StartDate" label="@L["StartDate"].Value" />
                </abp-column>
                <abp-column size-md="_6">
                    <abp-date-picker auto-update-input="true" today-button-classes="btn-primary" asp-for="HomeBanner.EndDate" label="@L["EndDate"].Value" />
                </abp-column>
            </abp-row>
        </abp-card-body>
    </abp-card>
</form>

<partial name="~/Pages/Shared/MediaLibraryPickerModal.cshtml" />
