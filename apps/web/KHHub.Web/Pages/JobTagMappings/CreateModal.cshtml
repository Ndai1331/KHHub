@page
@using Microsoft.AspNetCore.Mvc.Localization
@using KHHub.MasterDataService.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@using KHHub.Web.Pages.JobTagMappings
@using System.Globalization
@inject IHtmlLocalizer<MasterDataServiceResource> L
@model CreateModalModel
@{
    Layout = null;
}
<form data-ajaxForm="true" asp-page="/JobTagMappings/CreateModal" autocomplete="off">
    <abp-modal id="JobTagMappingCreateModal">
        <abp-modal-header title="@L["NewJobTagMapping"].Value"></abp-modal-header>
        <abp-modal-body>
@*//<suite-custom-code-block-1>*@
@*//</suite-custom-code-block-1>*@
            <abp-input asp-for="JobTagMapping.IsPrimary"    />
            <abp-input asp-for="JobTagMapping.SortOrder"    />
                                <abp-select asp-for="JobTagMapping.JobTagId" asp-items="Model.JobTagLookupListRequired" label="@L["JobTag"].Value"/>
            <abp-select asp-for="JobTagMapping.JobId" asp-items="Model.JobLookupListRequired" label="@L["Job"].Value"/>
@*//<suite-custom-code-block-2>*@
@*//</suite-custom-code-block-2>*@
@*//<suite-custom-code-block-3>*@
@*//</suite-custom-code-block-3>*@
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel|AbpModalButtons.Save)">
@*//<suite-custom-code-block-4>*@
@*//</suite-custom-code-block-4>*@
        </abp-modal-footer>
    </abp-modal>
</form>