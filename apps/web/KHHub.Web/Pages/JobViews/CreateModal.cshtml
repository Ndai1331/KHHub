@page
@using Microsoft.AspNetCore.Mvc.Localization
@using KHHub.MasterDataService.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@using KHHub.Web.Pages.JobViews
@using System.Globalization
@inject IHtmlLocalizer<MasterDataServiceResource> L
@model CreateModalModel
@{
    Layout = null;
}
<form data-ajaxForm="true" asp-page="/JobViews/CreateModal" autocomplete="off">
    <abp-modal id="JobViewCreateModal">
        <abp-modal-header title="@L["NewJobView"].Value"></abp-modal-header>
        <abp-modal-body>
@*//<suite-custom-code-block-1>*@
@*//</suite-custom-code-block-1>*@
            <abp-input asp-for="JobView.UserId"    />
            <abp-input asp-for="JobView.IpAddress"    />
            <abp-input asp-for="JobView.Device"    />
            <abp-date-picker auto-update-input="true" today-button-classes="btn-primary" asp-for="JobView.ViewedAt" data-date="@DateTime.Now.ToString("yyyy-MM-dd")" />
            <abp-input asp-for="JobView.Duration"    />
            <abp-input asp-for="JobView.Source"    />
                                <abp-select asp-for="JobView.JobId" asp-items="Model.JobLookupListRequired" label="@L["Job"].Value"/>
@*//<suite-custom-code-block-2>*@
@*//</suite-custom-code-block-2>*@
@*//<suite-custom-code-block-3>*@
@*//</suite-custom-code-block-3>*@
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel|AbpModalButtons.Save)">
@*//<suite-custom-code-block-4>*@
@*//</suite-custom-code-block-4>*@
        </abp-modal-footer>
    </abp-modal>
</form>