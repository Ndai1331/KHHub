@page "/jobs/{slug}"
@model KHHub.Publish_website.Pages.Jobs.DetailsModel
@{
    Layout = "/Pages/Shared/PublicContent/_CityBookPublicLayout.cshtml";
    ViewData["Title"] = Model.Seo.Title;
}

@section Meta {
    <meta name="description" content="@Model.Seo.Description">
    <link rel="canonical" href="@Model.Seo.CanonicalUrl">
    <meta property="og:title" content="@Model.Seo.Title">
    <meta property="og:description" content="@Model.Seo.Description">
    <meta property="og:type" content="@Model.Seo.OgType">
    <meta property="og:url" content="@Model.Seo.CanonicalUrl">
    <meta property="og:image" content="@Model.Seo.ImageUrl">
    <script type="application/ld+json">@Html.Raw(Model.JsonLd)</script>
    <script type="application/ld+json">@Html.Raw(Model.BreadcrumbJsonLd)</script>
}

@section Styles {
    <link rel="stylesheet" href="/template/css/public-content.css" asp-append-version="true">
}

<main class="kh-public-page">
    <article class="kh-detail">
        <nav class="kh-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Trang chủ</a><span>/</span><a href="@Model.ListPath">@Model.ListTitle</a><span>/</span><span>@Model.Detail.Title</span>
        </nav>
        <header class="kh-detail__header">
            <p>@Model.Detail.Category</p>
            <h1>@Model.Detail.Title</h1>
            <div class="kh-detail__meta">
                <span>@Model.Detail.AuthorOrCompany</span>
                <span>@Model.Detail.Province, @Model.Detail.Ward</span>
                <time datetime="@Model.Detail.CreatedAt.ToString("O")">@Model.Detail.CreatedAt.ToString("dd/MM/yyyy")</time>
                <button class="kh-favorite" type="button" data-favorite="@Model.Detail.Title" aria-pressed="false">
                    <i class="fa fa-heart-o" aria-hidden="true"></i> Lưu
                </button>
            </div>
        </header>
        <div class="kh-job-summary">
            <div>
                <span>Mức lương</span>
                <strong>@Model.Detail.Salary</strong>
            </div>
            <div>
                <span>Công ty</span>
                <strong>@Model.Detail.AuthorOrCompany</strong>
            </div>
            <div>
                <span>Khu vực</span>
                <strong>@Model.Detail.Ward, @Model.Detail.Province</strong>
            </div>
        </div>
        <div class="kh-detail__content">
            <h2>Mô tả công việc</h2>
            @Html.Raw(Model.Detail.ContentHtml)
            <h2>Yêu cầu</h2>
            <p>@Model.Detail.Requirements</p>
        </div>
        <partial name="~/Pages/Shared/PublicContent/_TagList.cshtml" model="Model.Detail.Tags" />
    </article>

    <partial name="~/Pages/Shared/PublicContent/_CommentSection.cshtml" model="Model.Detail" />

    @if (Model.Detail.RelatedItems.Count > 0)
    {
        var templateRoot = Url.Content("~/template");
        <section class="gray-section kh-detail-section" aria-labelledby="related-title">
            <div class="container">
                <div class="section-title">
                    <h2 id="related-title">Việc làm liên quan</h2>
                    <div class="section-subtitle">Gợi ý thêm công việc phù hợp để bạn tham khảo.</div>
                    <span class="section-separator"></span>
                    <p>Xem thêm các tin tuyển dụng cùng nhóm ngành hoặc khu vực.</p>
                    <a href="@Model.ListPath">Xem tất cả</a>
                </div>
            </div>
            <div class="list-carousel fl-wrap card-listing">
                <div class="listing-carousel fl-wrap">
                    @foreach (var item in Model.Detail.RelatedItems)
                    {
                        var location = string.Join(", ", new[] { item.Province, item.Ward }.Where(x => !string.IsNullOrWhiteSpace(x)));
                        var meta = string.IsNullOrWhiteSpace(item.MetaLabel) ? "Tin tuyển dụng mới" : item.MetaLabel;
                        <div class="slick-slide-item">
                            <div class="listing-item">
                                <article class="geodir-category-listing fl-wrap">
                                    <div class="geodir-category-img">
                                        <img src="@item.ThumbnailUrl" alt="@item.Title" loading="lazy" decoding="async">
                                        <div class="overlay"></div>
                                        <div class="list-post-counter"><span>@item.Popularity</span><i class="fa fa-eye"></i></div>
                                    </div>
                                    <div class="geodir-category-content fl-wrap">
                                        <a class="listing-geodir-category" href="@Model.ListPath">@item.Category</a>
                                        <div class="listing-avatar">
                                            <a href="@item.Url"><img src="@(templateRoot)/images/avatar/1.jpg" alt="@item.Title"></a>
                                            <span class="avatar-tooltip">Đăng bởi <strong>KH HUB</strong></span>
                                        </div>
                                        <h3><a href="@item.Url">@item.Title</a></h3>
                                        <div class="geodir-category-options fl-wrap">
                                            <div class="listing-rating card-popup-rainingvis" data-starrating2="@(item.Rating ?? 4)">
                                                <span>@meta</span>
                                            </div>
                                            <div class="geodir-category-location">
                                                <a href="@item.Url"><i class="fa fa-map-marker" aria-hidden="true"></i> @location</a>
                                            </div>
                                        </div>
                                    </div>
                                </article>
                            </div>
                        </div>
                    }
                </div>
                <div class="swiper-button-prev sw-btn"><i class="fa fa-long-arrow-left"></i></div>
                <div class="swiper-button-next sw-btn"><i class="fa fa-long-arrow-right"></i></div>
            </div>
        </section>
    }
</main>

@section Scripts {
    <script src="/template/js/public-content.js" asp-append-version="true" defer></script>
}
