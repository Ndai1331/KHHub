@page
@model KHHub.Publish_website.Pages.IndexModel
@using System.Text.Encodings.Web
@using System.Text.Json
@{
    Layout = null;
    ViewData["Title"] = L["Landing:PageTitle"];
    var templateRoot = Url.Content("~/template");
    var siteUrl = $"{Request.Scheme}://{Request.Host}/";
    var jsonLd = JsonSerializer.Serialize(
        new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "WebSite",
            ["name"] = L["Landing:PageTitle"],
            ["description"] = L["Landing:MetaDescription"],
            ["url"] = siteUrl
        },
        new JsonSerializerOptions { Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping });
}
<!DOCTYPE HTML>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
    <head>
        <meta charset="UTF-8">
        <title>@ViewData["Title"]</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=no">
        <meta name="robots" content="index, follow" />
        <meta name="keywords" content="@L["Landing:MetaKeywords"]" />
        <meta name="description" content="@L["Landing:MetaDescription"]" />
        <meta itemprop="name" content="@L["Landing:PageTitle"]" />
        <meta itemprop="description" content="@L["Landing:MetaDescription"]" />
        <link itemprop="url" href="@siteUrl" />
        <script type="application/ld+json">
@Html.Raw(jsonLd)
        </script>
        <link type="text/css" rel="stylesheet" href="@(templateRoot)/css/reset.css">
        <link type="text/css" rel="stylesheet" href="@(templateRoot)/css/plugins.css">
        <link type="text/css" rel="stylesheet" href="@(templateRoot)/css/style.css">
        <link type="text/css" rel="stylesheet" href="@(templateRoot)/css/color.css">
        <link type="text/css" rel="stylesheet" href="@(templateRoot)/css/khhub.css">
        <link rel="shortcut icon" href="@(templateRoot)/images/favicon.ico">
    </head>
    <body class="khhub-theme">
        <div class="loader-wrap">
            <div class="pin"></div>
            <div class="pulse"></div>
        </div>
        <div id="main" itemscope itemtype="https://schema.org/WebSite">
            <partial name="~/Pages/Shared/Landing/_Header.cshtml" model="Model" />
            <partial name="~/Pages/Shared/Landing/_HeroSlider.cshtml" model="Model" />
            <div id="wrapper" class="no-padding">
                <div class="content">
                    <partial name="~/Pages/Shared/Landing/_JobsSection.cshtml" />
                    <partial name="~/Pages/Shared/Landing/_CategoriesSection.cshtml" />
                    <partial name="~/Pages/Shared/Landing/_PopularPlacesSection.cshtml" />
                    <partial name="~/Pages/Shared/Landing/_CommunitySection.cshtml" />
                </div>
            </div>
            <partial name="~/Pages/Shared/Landing/_CityBookFooter.cshtml" />
            <partial name="~/Pages/Shared/Landing/_AuthModal.cshtml" />
            <a class="to-top"><i class="fa fa-angle-up"></i></a>
        </div>
        <script type="text/javascript" src="@(templateRoot)/js/jquery.min.js"></script>
        <script type="text/javascript" src="@(templateRoot)/js/plugins.js"></script>
        <script type="text/javascript" src="@(templateRoot)/js/scripts.js"></script>
        <script type="text/javascript">
            (function () {
                var selector = document.getElementById('khhub-language-select');
                if (!selector) {
                    return;
                }

                selector.addEventListener('change', function () {
                    var culture = selector.value || 'vi';
                    var url = new URL(window.location.href);
                    url.searchParams.set('culture', culture);
                    url.searchParams.set('ui-culture', culture);
                    window.location.href = url.toString();
                });
            })();
        </script>
    </body>
</html>
