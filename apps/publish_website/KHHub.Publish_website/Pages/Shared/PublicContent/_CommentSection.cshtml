@model DetailPageViewModel
@{
    var isAuthenticated = ViewContext.HttpContext.User?.Identity?.IsAuthenticated == true;
    var returnUrl = (ViewContext.HttpContext.Request.Path.Value ?? "/") + ViewContext.HttpContext.Request.QueryString.Value;
    var loginUrl = Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/Account/Login", "returnUrl", returnUrl);
}

<section class="kh-detail-section" aria-labelledby="comments-title">
    <div class="kh-section-title">
        <h2 id="comments-title">Bình luận</h2>
        <span>Chia sẻ trải nghiệm từ cộng đồng</span>
    </div>

    @if (!isAuthenticated)
    {
        <div class="kh-auth-required" role="status">
            <i class="fa fa-lock" aria-hidden="true"></i>
            <span>Vui lòng đăng nhập để bình luận và đánh giá.</span>
            <a class="kh-button kh-button--primary" href="@loginUrl">Đăng nhập để tiếp tục</a>
        </div>
    }

    <form class="kh-comment-form" data-requires-auth="true">
        <label>
            <span>Đánh giá của bạn</span>
            <select aria-label="Chọn số sao" disabled="@(!isAuthenticated ? "disabled" : null)">
                <option>5 sao</option>
                <option>4 sao</option>
                <option>3 sao</option>
            </select>
        </label>
        <label>
            <span>Nội dung</span>
            <textarea rows="4" placeholder="Chia sẻ trải nghiệm hoặc câu hỏi của bạn" disabled="@(!isAuthenticated ? "disabled" : null)"></textarea>
        </label>
        <button class="kh-button kh-button--primary" type="button">@(isAuthenticated ? "Gửi bình luận" : "Đăng nhập để bình luận")</button>
    </form>

    <div class="kh-comments">
        @foreach (var comment in Model.Comments)
        {
            <article class="kh-comment">
                <div>
                    <strong>@comment.Author</strong>
                    <time datetime="@comment.CreatedAt.ToString("O")">@comment.CreatedAt.ToString("dd/MM/yyyy")</time>
                </div>
                <partial name="~/Pages/Shared/PublicContent/_RatingStars.cshtml" model="comment.Rating" />
                <p>@comment.Body</p>
            </article>
        }
    </div>
</section>
