<footer class="kh-public-footer">
    <div>
        <strong>KH HUB</strong>
        <p>Nền tảng khám phá tin tức, việc làm và địa điểm tại Khánh Hòa.</p>
    </div>
    <nav aria-label="Footer">
        @{
            var isEn = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.Equals("en", StringComparison.OrdinalIgnoreCase);
            var newsPath = isEn ? "/news" : "/tin-tuc";
            var jobsPath = isEn ? "/jobs" : "/viec-lam";
            var placesPath = isEn ? "/places" : "/dia-diem";
        }
        <a href="@newsPath">Tin tức</a>
        <a href="@jobsPath">Việc làm</a>
        <a href="@placesPath">Địa điểm</a>
    </nav>
</footer>
