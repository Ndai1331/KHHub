@{
    var path = Context.Request.Path.Value ?? "/";
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var isEn = currentCulture.Equals("en", StringComparison.OrdinalIgnoreCase);
    var newsPath = isEn ? "/news" : "/tin-tuc";
    var jobsPath = isEn ? "/jobs" : "/viec-lam";
    var placesPath = isEn ? "/places" : "/dia-diem";
    string ActiveNews() => path.StartsWith("/news", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/tin-tuc", StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty;
    string ActiveJobs() => path.StartsWith("/jobs", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/viec-lam", StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty;
    string ActivePlaces() => path.StartsWith("/places", StringComparison.OrdinalIgnoreCase) || path.StartsWith("/dia-diem", StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty;
}

<header class="kh-public-header">
    <a class="kh-public-header__brand" href="/" aria-label="KH HUB home">
        <span>KH</span> HUB
    </a>
    <nav aria-label="Public content">
        <a class="@ActiveNews()" href="@newsPath">Tin tức</a>
        <a class="@ActiveJobs()" href="@jobsPath">Việc làm</a>
        <a class="@ActivePlaces()" href="@placesPath">Địa điểm</a>
    </nav>
    <a class="kh-public-header__cta" href="@placesPath">Khám phá</a>
</header>
