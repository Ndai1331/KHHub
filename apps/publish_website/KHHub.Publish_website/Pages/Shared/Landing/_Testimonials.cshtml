@model KHHub.Publish_website.Pages.IndexModel

<section class="landing-section landing-testimonials py-5">
    <div class="container">
        <div class="text-center mb-4">
            <h2 class="landing-section__title">@L["Landing:TestimonialsTitle"]</h2>
            <p class="landing-section__lead mb-0">@L["Landing:TestimonialsLead"]</p>
        </div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <article class="landing-testimonial-card h-100">
                    <p class="mb-3">“@L["Landing:Testimonial1Quote"]”</p>
                    <h3 class="h6 mb-1">@L["Landing:Testimonial1Author"]</h3>
                    <p class="small text-muted mb-0">@L["Landing:Testimonial1Role"]</p>
                </article>
            </div>
            <div class="col-md-6 col-lg-4">
                <article class="landing-testimonial-card h-100">
                    <p class="mb-3">“@L["Landing:Testimonial2Quote"]”</p>
                    <h3 class="h6 mb-1">@L["Landing:Testimonial2Author"]</h3>
                    <p class="small text-muted mb-0">@L["Landing:Testimonial2Role"]</p>
                </article>
            </div>
            <div class="col-md-6 col-lg-4">
                <article class="landing-testimonial-card h-100">
                    <p class="mb-3">“@L["Landing:Testimonial3Quote"]”</p>
                    <h3 class="h6 mb-1">@L["Landing:Testimonial3Author"]</h3>
                    <p class="small text-muted mb-0">@L["Landing:Testimonial3Role"]</p>
                </article>
            </div>
        </div>
    </div>
</section>
