@{
    var templateRoot = Url.Content("~/template");
}

<section class="color-bg">
    <div class="shapes-bg-big"></div>
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <div class="images-collage fl-wrap">
                    <div class="images-collage-title">KH<span>HUB</span></div>
                    <div class="images-collage-main images-collage-item"><img src="@(templateRoot)/images/avatar/1.jpg" alt=""></div>
                    <div class="images-collage-other images-collage-item" data-position-left="23" data-position-top="10" data-zindex="2"><img src="@(templateRoot)/images/avatar/1.jpg" alt=""></div>
                    <div class="images-collage-other images-collage-item" data-position-left="62" data-position-top="54" data-zindex="5"><img src="@(templateRoot)/images/avatar/1.jpg" alt=""></div>
                    <div class="images-collage-other images-collage-item anim-col" data-position-left="18" data-position-top="70" data-zindex="11"><img src="@(templateRoot)/images/avatar/1.jpg" alt=""></div>
                    <div class="images-collage-other images-collage-item" data-position-left="37" data-position-top="90" data-zindex="1"><img src="@(templateRoot)/images/avatar/1.jpg" alt=""></div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="color-bg-text">
                    <h3>@L["Landing:CommunityTitle"]</h3>
                    <p>@L["Landing:CommunityLead"]</p>
                    <a href="#" class="color-bg-link modal-open">@L["Landing:SignInNow"]</a>
                </div>
            </div>
        </div>
    </div>
</section>
