@model KHHub.Publish_website.Pages.IndexModel

<section class="section trending-list-nine py-5">
    <div class="container">
        <div class="text-center mb-4">
            <h2 class="landing-section__title">@L["Landing:TrendingTitle"]</h2>
            <p class="landing-section__lead mb-0">@L["Landing:TrendingLead"]</p>
        </div>
        <div class="row g-4">
            <div class="col-sm-6 col-lg-3">
                <article class="landing-trending-card h-100">
                    <img src="/assets/img/tours/tours-71.jpg" alt="@L["Landing:TrendingCard1Title"]" loading="lazy" width="640" height="420" />
                    <div class="p-3">
                        <h3 class="h6 mb-2">@L["Landing:TrendingCard1Title"]</h3>
                        <p class="small text-muted mb-0">@L["Landing:TrendingCard1Text"]</p>
                    </div>
                </article>
            </div>
            <div class="col-sm-6 col-lg-3">
                <article class="landing-trending-card h-100">
                    <img src="/assets/img/hotels/hotel-06.jpg" alt="@L["Landing:TrendingCard2Title"]" loading="lazy" width="640" height="420" />
                    <div class="p-3">
                        <h3 class="h6 mb-2">@L["Landing:TrendingCard2Title"]</h3>
                        <p class="small text-muted mb-0">@L["Landing:TrendingCard2Text"]</p>
                    </div>
                </article>
            </div>
            <div class="col-sm-6 col-lg-3">
                <article class="landing-trending-card h-100">
                    <img src="/assets/img/cruise/cruise-09.jpg" alt="@L["Landing:TrendingCard3Title"]" loading="lazy" width="640" height="420" />
                    <div class="p-3">
                        <h3 class="h6 mb-2">@L["Landing:TrendingCard3Title"]</h3>
                        <p class="small text-muted mb-0">@L["Landing:TrendingCard3Text"]</p>
                    </div>
                </article>
            </div>
            <div class="col-sm-6 col-lg-3">
                <article class="landing-trending-card h-100">
                    <img src="/assets/img/activities/activity-04.jpg" alt="@L["Landing:TrendingCard4Title"]" loading="lazy" width="640" height="420" />
                    <div class="p-3">
                        <h3 class="h6 mb-2">@L["Landing:TrendingCard4Title"]</h3>
                        <p class="small text-muted mb-0">@L["Landing:TrendingCard4Text"]</p>
                    </div>
                </article>
            </div>
        </div>
    </div>
</section>
