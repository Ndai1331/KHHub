@{
    var request = ViewContext.HttpContext.Request;
    var currentPath = request.Path.Value ?? "/";
    var currentQuery = request.QueryString.Value ?? string.Empty;
    var returnUrl = currentPath + currentQuery;
    var loginUrl = Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/Account/Login", "returnUrl", returnUrl);
}
<div class="main-register-wrap modal">
    <div class="main-overlay"></div>
    <div class="main-register-holder">
        <div class="main-register fl-wrap">
            <div class="close-reg"><i class="fa fa-times"></i></div>
            <h3>@L["Landing:SignIn"] <span>KH<strong>HUB</strong></span></h3>
            <div class="soc-log fl-wrap">
                <p>@L["Auth:SocialLoginLead"]</p>
                <a href="@loginUrl" class="facebook-log"><i class="fa fa-facebook-official"></i>@L["Auth:LoginWithFacebook"]</a>
                <a href="@loginUrl" class="twitter-log kh-google-log"><i class="fa fa-google"></i> @L["Auth:LoginWithGoogle"]</a>
            </div>
            <div class="log-separator fl-wrap"><span>@L["Auth:Or"]</span></div>
            <div id="tabs-container">
                <ul class="tabs-menu">
                    <li class="current"><a href="#tab-1">@L["Landing:SignIn"]</a></li>
                    <li><a href="#tab-2">@L["Landing:Register"]</a></li>
                </ul>
                <div class="tab">
                    <div id="tab-1" class="tab-content">
                        <div class="custom-form">
                            <form method="get" action="/Account/Login" name="registerform">
                                <input type="hidden" name="returnUrl" value="@returnUrl">
                                <label>@L["Auth:UserNameOrEmail"] *</label>
                                <input name="email" type="text" onclick="this.select()" value="">
                                <label>@L["Auth:Password"] *</label>
                                <input name="password" type="password" onclick="this.select()" value="">
                                <button type="submit" class="log-submit-btn"><span>@L["Landing:SignIn"]</span></button>
                                <div class="clearfix"></div>
                                <div class="filter-tags">
                                    <input id="check-a" type="checkbox" name="check">
                                    <label for="check-a">@L["Auth:RememberMe"]</label>
                                </div>
                            </form>
                            <div class="lost_password">
                                <a href="#">@L["Auth:ForgotPassword"]</a>
                            </div>
                        </div>
                    </div>
                    <div class="tab">
                        <div id="tab-2" class="tab-content">
                            <div class="custom-form">
                                <form method="post" name="registerform" class="main-register-form" id="main-register-form2">
                                    <label>@L["Auth:LastName"] *</label>
                                    <input name="name" type="text" onclick="this.select()" value="">
                                    <label>@L["Auth:FirstName"] *</label>
                                    <input name="name2" type="text" onclick="this.select()" value="">
                                    <label>Email *</label>
                                    <input name="email" type="text" onclick="this.select()" value="">
                                    <label>@L["Auth:Password"] *</label>
                                    <input name="password" type="password" onclick="this.select()" value="">
                                    <button type="submit" class="log-submit-btn"><span>@L["Landing:Register"]</span></button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
