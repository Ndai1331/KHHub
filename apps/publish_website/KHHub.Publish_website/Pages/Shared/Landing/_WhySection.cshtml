@model KHHub.Publish_website.Pages.IndexModel

<section class="landing-section landing-why py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="landing-section__title">@L["Landing:WhyTitle"]</h2>
            <p class="landing-section__lead text-muted mb-0">@L["Landing:WhyLead"]</p>
        </div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="landing-feature abp-card h-100 border-0 shadow-sm">
                    <div class="abp-card-body">
                        <div class="landing-feature__icon mb-3" aria-hidden="true">
                            <i class="fa fa-map-marker"></i>
                        </div>
                        <h3 class="h6">@L["Landing:WhyPoint1Title"]</h3>
                        <p class="text-muted small mb-0">@L["Landing:WhyPoint1Text"]</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="landing-feature abp-card h-100 border-0 shadow-sm">
                    <div class="abp-card-body">
                        <div class="landing-feature__icon mb-3" aria-hidden="true">
                            <i class="fa fa-shield"></i>
                        </div>
                        <h3 class="h6">@L["Landing:WhyPoint2Title"]</h3>
                        <p class="text-muted small mb-0">@L["Landing:WhyPoint2Text"]</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="landing-feature abp-card h-100 border-0 shadow-sm">
                    <div class="abp-card-body">
                        <div class="landing-feature__icon mb-3" aria-hidden="true">
                            <i class="fa fa-star"></i>
                        </div>
                        <h3 class="h6">@L["Landing:WhyPoint3Title"]</h3>
                        <p class="text-muted small mb-0">@L["Landing:WhyPoint3Text"]</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="landing-feature abp-card h-100 border-0 shadow-sm">
                    <div class="abp-card-body">
                        <div class="landing-feature__icon mb-3" aria-hidden="true">
                            <i class="fa fa-headphones"></i>
                        </div>
                        <h3 class="h6">@L["Landing:WhyPoint4Title"]</h3>
                        <p class="text-muted small mb-0">@L["Landing:WhyPoint4Text"]</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mt-2">
            <div class="col-6 col-md-3 text-center">
                <div class="landing-stat">
                    <div class="landing-stat__value">50+</div>
                    <div class="landing-stat__label text-muted small">@L["Landing:StatExperiences"]</div>
                </div>
            </div>
            <div class="col-6 col-md-3 text-center">
                <div class="landing-stat">
                    <div class="landing-stat__value">24/7</div>
                    <div class="landing-stat__label text-muted small">@L["Landing:StatSupport"]</div>
                </div>
            </div>
            <div class="col-6 col-md-3 text-center">
                <div class="landing-stat">
                    <div class="landing-stat__value">100%</div>
                    <div class="landing-stat__label text-muted small">@L["Landing:StatLocal"]</div>
                </div>
            </div>
            <div class="col-6 col-md-3 text-center">
                <div class="landing-stat">
                    <div class="landing-stat__value">KH</div>
                    <div class="landing-stat__label text-muted small">@L["Landing:StatRegion"]</div>
                </div>
            </div>
        </div>
    </div>
</section>
