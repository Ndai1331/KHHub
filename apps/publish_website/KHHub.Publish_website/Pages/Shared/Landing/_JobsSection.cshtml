@{
    var templateRoot = Url.Content("~/template");
}

<section class="khhub-job-section">
    <div class="container">
        <div class="section-title">
            <h2>@L["Landing:JobsTitle"]</h2>
            <div class="section-subtitle">New Jobs</div>
            <span class="section-separator"></span>
            <p>@L["Landing:JobsLead"]</p>
        </div>
        <div class="khhub-job-list">
            <article class="khhub-job-card">
                <div class="khhub-job-card__media">
                    <img src="@(templateRoot)/images/all/1.jpg" alt="@L["Landing:Job1Title"]">
                    <span class="khhub-job-badge">Trending</span>
                </div>
                <div class="khhub-job-card__content">
                    <div class="khhub-job-card__head">
                        <h3>@L["Landing:Job1Title"]</h3>
                        <div class="khhub-job-meta">
                            <span>@L["Category:Hotel"]</span>
                            <span class="khhub-job-rating">5.0</span>
                            <span>@L["Landing:ViewsFormat", 105]</span>
                        </div>
                    </div>
                    <div class="khhub-job-location"><i class="fa fa-map-marker"></i> @L["Location:NhaTrangKhanhHoa"]</div>
                    <p>@L["Landing:Job1Description"]</p>
                    <div class="khhub-job-card__footer">
                        <div class="khhub-job-tags">
                            <span><i class="fa fa-clock-o"></i> @L["Job:FullTime"]</span>
                            <span><i class="fa fa-users"></i> @L["Landing:PositionFormat", "01"]</span>
                        </div>
                        <div class="khhub-job-salary">
                            @L["Landing:SalaryFrom"] <strong>@L["Landing:Job1Salary"]</strong>
                        </div>
                    </div>
                </div>
            </article>
            <article class="khhub-job-card">
                <div class="khhub-job-card__media">
                    <img src="@(templateRoot)/images/bg/1.jpg" alt="@L["Landing:Job2Title"]">
                    <span class="khhub-job-badge">New</span>
                </div>
                <div class="khhub-job-card__content">
                    <div class="khhub-job-card__head">
                        <h3>@L["Landing:Job2Title"]</h3>
                        <div class="khhub-job-meta">
                            <span>@L["Category:Restaurant"]</span>
                            <span class="khhub-job-rating">4.8</span>
                            <span>@L["Landing:ViewsFormat", 78]</span>
                        </div>
                    </div>
                    <div class="khhub-job-location"><i class="fa fa-map-marker"></i> @L["Location:CamRanhKhanhHoa"]</div>
                    <p>@L["Landing:Job2Description"]</p>
                    <div class="khhub-job-card__footer">
                        <div class="khhub-job-tags">
                            <span><i class="fa fa-clock-o"></i> @L["Job:Shift"]</span>
                            <span><i class="fa fa-users"></i> @L["Landing:PositionFormat", "02"]</span>
                        </div>
                        <div class="khhub-job-salary">
                            @L["Landing:SalaryFrom"] <strong>@L["Landing:Job2Salary"]</strong>
                        </div>
                    </div>
                </div>
            </article>
            <article class="khhub-job-card">
                <div class="khhub-job-card__media">
                    <img src="@(templateRoot)/images/all/1.jpg" alt="@L["Landing:Job3Title"]">
                    <span class="khhub-job-badge">Hot</span>
                </div>
                <div class="khhub-job-card__content">
                    <div class="khhub-job-card__head">
                        <h3>@L["Landing:Job3Title"]</h3>
                        <div class="khhub-job-meta">
                            <span>@L["Category:Travel"]</span>
                            <span class="khhub-job-rating">4.9</span>
                            <span>@L["Landing:ViewsFormat", 126]</span>
                        </div>
                    </div>
                    <div class="khhub-job-location"><i class="fa fa-map-marker"></i> @L["Location:NinhHoaKhanhHoa"]</div>
                    <p>@L["Landing:Job3Description"]</p>
                    <div class="khhub-job-card__footer">
                        <div class="khhub-job-tags">
                            <span><i class="fa fa-clock-o"></i> @L["Job:FullTime"]</span>
                            <span><i class="fa fa-users"></i> @L["Landing:PositionFormat", "03"]</span>
                        </div>
                        <div class="khhub-job-salary">
                            @L["Landing:SalaryFrom"] <strong>@L["Landing:Job3Salary"]</strong>
                        </div>
                    </div>
                </div>
            </article>
        </div>
    </div>
</section>
