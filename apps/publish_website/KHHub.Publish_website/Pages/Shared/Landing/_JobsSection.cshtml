@model KHHub.Publish_website.Pages.IndexModel

<section class="khhub-job-section">
    <div class="container">
        <div class="section-title">
            <h2>@L["Landing:JobsTitle"]</h2>
            <div class="section-subtitle">New Jobs</div>
            <span class="section-separator"></span>
            <p>@L["Landing:JobsLead"]</p>
        </div>
        @if (Model.Jobs.Count == 0)
        {
            <div class="kh-empty text-center">
                <p>@L["Landing:NoJobsYet"]</p>
            </div>
        }
        else
        {
            <div class="khhub-job-list">
                @foreach (var job in Model.Jobs.Take(10))
                {
                    var imageUrl = Model.ResolveMediaUrl(job.ThumbnailUrl);
                    <article class="khhub-job-card">
                        <a class="khhub-job-card__media" href="@job.Url" aria-label="@job.Title">
                            <img src="@imageUrl" alt="@job.Title" loading="lazy" decoding="async" width="640" height="360">
                            <span class="khhub-job-badge">@job.Category</span>
                        </a>
                        <div class="khhub-job-card__content">
                            <div class="khhub-job-card__head">
                                <h3><a href="@job.Url">@job.Title</a></h3>
                                <div class="khhub-job-meta">
                                    <span>@job.Category</span>
                                    <span>@L["Landing:ViewsFormat", job.Popularity]</span>
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(job.Province))
                            {
                                <div class="khhub-job-location">
                                    <i class="fa fa-map-marker"></i> @job.Province, @job.Ward
                                </div>
                            }
                            <p>@job.Description</p>
                            <div class="khhub-job-card__footer">
                                <div class="khhub-job-tags">
                                    @foreach (var tag in job.Tags.Take(2))
                                    {
                                        <span><i class="fa fa-tag"></i> @tag</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(job.MetaLabel))
                                {
                                    <div class="khhub-job-salary">
                                        <strong>@job.MetaLabel</strong>
                                    </div>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
            <div class="text-center mt-4">
                <a class="kh-button kh-button--primary" href="@Model.JobsListPath">@L["Landing:ViewAllJobs"]</a>
            </div>
        }
    </div>
</section>
