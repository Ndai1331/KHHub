@{
    var templateRoot = Url.Content("~/template");
}

<section id="sec2">
    <div class="container">
        <div class="section-title">
            <h2>@L["Landing:CategoriesTitle"]</h2>
            <div class="section-subtitle">Catalog of Categories</div>
            <span class="section-separator"></span>
            <p>@L["Landing:CategoriesLead"]</p>
        </div>
        <div class="gallery-items fl-wrap mr-bot spad">
            <div class="gallery-item">
                <div class="grid-item-holder">
                    <div class="listing-item-grid">
                        <img src="@(templateRoot)/images/all/1.jpg" alt="@L["Landing:CategoryGridDecorImage"]">
                        <div class="listing-counter"><span>10 </span> @L["Landing:PlaceCountLabel"]</div>
                        <div class="listing-item-cat">
                            <h3><a href="listing.html">@L["Category:ConferenceEvent"]</a></h3>
                            <p>@L["Category:ConferenceEventText"]</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="gallery-item gallery-item-second">
                <div class="grid-item-holder">
                    <div class="listing-item-grid">
                        <img src="@(templateRoot)/images/bg/1.jpg" alt="@L["Landing:CategoryGridDecorImage"]">
                        <div class="listing-counter"><span>6 </span> @L["Landing:PlaceCountLabel"]</div>
                        <div class="listing-item-cat">
                            <h3><a href="listing.html">Cafe - Pub</a></h3>
                            <p>@L["Category:CafePubText"]</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="gallery-item">
                <div class="grid-item-holder">
                    <div class="listing-item-grid">
                        <img src="@(templateRoot)/images/all/1.jpg" alt="@L["Landing:CategoryGridDecorImage"]">
                        <div class="listing-counter"><span>21 </span> @L["Landing:PlaceCountLabel"]</div>
                        <div class="listing-item-cat">
                            <h3><a href="listing.html">Gym - Fitness</a></h3>
                            <p>@L["Category:GymFitnessText"]</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="gallery-item">
                <div class="grid-item-holder">
                    <div class="listing-item-grid">
                        <img src="@(templateRoot)/images/all/1.jpg" alt="@L["Landing:CategoryGridDecorImage"]">
                        <div class="listing-counter"><span>7 </span> @L["Landing:PlaceCountLabel"]</div>
                        <div class="listing-item-cat">
                            <h3><a href="listing.html">@L["Category:Hotel"]</a></h3>
                            <p>@L["Category:HotelText"]</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="gallery-item">
                <div class="grid-item-holder">
                    <div class="listing-item-grid">
                        <img src="@(templateRoot)/images/all/1.jpg" alt="@L["Landing:CategoryGridDecorImage"]">
                        <div class="listing-counter"><span>15 </span> @L["Landing:PlaceCountLabel"]</div>
                        <div class="listing-item-cat">
                            <h3><a href="listing.html">@L["Category:Shop"]</a></h3>
                            <p>@L["Category:ShopText"]</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <a href="listing.html" class="btn big-btn circle-btn dec-btn color-bg flat-btn">@L["Landing:ViewAll"]<i class="fa fa-eye"></i></a>
    </div>
</section>
