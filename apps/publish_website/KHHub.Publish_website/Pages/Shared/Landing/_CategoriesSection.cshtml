@{
    var templateRoot = Url.Content("~/template");
}

<section id="sec2">
    <div class="container">
        <div class="section-title">
            <h2>Danh mục nổi bật</h2>
            <div class="section-subtitle">Catalog of Categories</div>
            <span class="section-separator"></span>
            <p>Khám phá các nhóm trải nghiệm được quan tâm tại Khánh Hòa.</p>
        </div>
        <div class="gallery-items fl-wrap mr-bot spad">
            <div class="gallery-item">
                <div class="grid-item-holder">
                    <div class="listing-item-grid">
                        <img src="@(templateRoot)/images/all/1.jpg" alt="">
                        <div class="listing-counter"><span>10 </span> Địa điểm</div>
                        <div class="listing-item-cat">
                            <h3><a href="listing.html">Hội nghị và sự kiện</a></h3>
                            <p>Không gian tổ chức sự kiện, hội nghị và hoạt động cộng đồng.</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="gallery-item gallery-item-second">
                <div class="grid-item-holder">
                    <div class="listing-item-grid">
                        <img src="@(templateRoot)/images/bg/1.jpg" alt="">
                        <div class="listing-counter"><span>6 </span> Địa điểm</div>
                        <div class="listing-item-cat">
                            <h3><a href="listing.html">Cafe - Pub</a></h3>
                            <p>Các điểm hẹn thư giãn, cafe và giải trí về đêm.</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="gallery-item">
                <div class="grid-item-holder">
                    <div class="listing-item-grid">
                        <img src="@(templateRoot)/images/all/1.jpg" alt="">
                        <div class="listing-counter"><span>21 </span> Địa điểm</div>
                        <div class="listing-item-cat">
                            <h3><a href="listing.html">Gym - Fitness</a></h3>
                            <p>Địa điểm thể thao, chăm sóc sức khỏe và phong cách sống năng động.</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="gallery-item">
                <div class="grid-item-holder">
                    <div class="listing-item-grid">
                        <img src="@(templateRoot)/images/all/1.jpg" alt="">
                        <div class="listing-counter"><span>7 </span> Địa điểm</div>
                        <div class="listing-item-cat">
                            <h3><a href="listing.html">Khách sạn</a></h3>
                            <p>Lưu trú tiện nghi cho chuyến đi Khánh Hòa.</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="gallery-item">
                <div class="grid-item-holder">
                    <div class="listing-item-grid">
                        <img src="@(templateRoot)/images/all/1.jpg" alt="">
                        <div class="listing-counter"><span>15 </span> Địa điểm</div>
                        <div class="listing-item-cat">
                            <h3><a href="listing.html">Cửa hàng</a></h3>
                            <p>Điểm mua sắm, sản phẩm địa phương và dịch vụ tiện ích.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <a href="listing.html" class="btn big-btn circle-btn dec-btn color-bg flat-btn">Xem tất cả<i class="fa fa-eye"></i></a>
    </div>
</section>
