@model KHHub.Publish_website.Pages.IndexModel

<section class="tourism-sec py-5">
    <div class="container">
        <div class="text-center mb-4">
            <h2 class="landing-section__title">@L["Landing:TourismTitle"]</h2>
            <p class="landing-section__lead mb-0">@L["Landing:TourismLead"]</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <article class="landing-tourism-card h-100">
                    <div class="landing-tourism-card__icon" aria-hidden="true">
                        <img src="/assets/img/icons/tourism-icon1.svg" alt="" role="presentation" loading="lazy" width="48" height="48" decoding="async" />
                    </div>
                    <h3 class="h6 mt-3">@L["Landing:TourismPoint1Title"]</h3>
                    <p class="small text-muted mb-0">@L["Landing:TourismPoint1Text"]</p>
                </article>
            </div>
            <div class="col-md-4">
                <article class="landing-tourism-card h-100">
                    <div class="landing-tourism-card__icon" aria-hidden="true">
                        <img src="/assets/img/icons/tourism-icon2.svg" alt="" role="presentation" loading="lazy" width="48" height="48" decoding="async" />
                    </div>
                    <h3 class="h6 mt-3">@L["Landing:TourismPoint2Title"]</h3>
                    <p class="small text-muted mb-0">@L["Landing:TourismPoint2Text"]</p>
                </article>
            </div>
            <div class="col-md-4">
                <article class="landing-tourism-card h-100">
                    <div class="landing-tourism-card__icon" aria-hidden="true">
                        <img src="/assets/img/icons/tourism-icon3.svg" alt="" role="presentation" loading="lazy" width="48" height="48" decoding="async" />
                    </div>
                    <h3 class="h6 mt-3">@L["Landing:TourismPoint3Title"]</h3>
                    <p class="small text-muted mb-0">@L["Landing:TourismPoint3Text"]</p>
                </article>
            </div>
        </div>
    </div>
</section>
