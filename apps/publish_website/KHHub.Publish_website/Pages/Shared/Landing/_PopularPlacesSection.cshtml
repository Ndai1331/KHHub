@{
    var templateRoot = Url.Content("~/template");
    var places = new[]
    {
        new { CategoryKey = "Category:Shopping", TitleKey = "Landing:PopularPlace1Title", DescriptionKey = "Landing:PopularPlace1Description", LocationKey = "Location:NhaTrangKhanhHoa", Rating = 5, Reviews = 7, Likes = 4 },
        new { CategoryKey = "Category:Event", TitleKey = "Landing:PopularPlace2Title", DescriptionKey = "Landing:PopularPlace2Description", LocationKey = "Location:NhaTrangKhanhHoa", Rating = 4, Reviews = 17, Likes = 15 },
        new { CategoryKey = "Category:Sports", TitleKey = "Landing:PopularPlace3Title", DescriptionKey = "Landing:PopularPlace3Description", LocationKey = "Location:NhaTrangKhanhHoa", Rating = 3, Reviews = 16, Likes = 13 },
        new { CategoryKey = "Category:Shop", TitleKey = "Landing:PopularPlace4Title", DescriptionKey = "Landing:PopularPlace4Description", LocationKey = "Location:NhaTrangKhanhHoa", Rating = 4, Reviews = 6, Likes = 3 },
        new { CategoryKey = "Category:Transport", TitleKey = "Landing:PopularPlace5Title", DescriptionKey = "Landing:PopularPlace5Description", LocationKey = "Location:KhanhHoa", Rating = 5, Reviews = 11, Likes = 35 },
        new { CategoryKey = "Category:Restaurant", TitleKey = "Landing:PopularPlace6Title", DescriptionKey = "Landing:PopularPlace6Description", LocationKey = "Location:NhaTrangKhanhHoa", Rating = 5, Reviews = 7, Likes = 553 }
    };
}

<section class="gray-section">
    <div class="container">
        <div class="section-title">
            <h2>@L["Landing:PopularPlacesTitle"]</h2>
            <div class="section-subtitle">@L["Landing:PopularPlacesLead"]</div>
            <span class="section-separator"></span>
            <p>@L["Landing:PopularPlacesLead"]</p>
        </div>
    </div>
    <div class="list-carousel fl-wrap card-listing">
        <div class="listing-carousel fl-wrap">
            @foreach (var place in places)
            {
                <div class="slick-slide-item">
                    <div class="listing-item">
                        <article class="geodir-category-listing fl-wrap">
                            <div class="geodir-category-img">
                                <img src="@(templateRoot)/images/all/1.jpg" alt="">
                                <div class="overlay"></div>
                                <div class="list-post-counter"><span>@place.Likes</span><i class="fa fa-heart"></i></div>
                            </div>
                            <div class="geodir-category-content fl-wrap">
                                <a class="listing-geodir-category" href="listing.html">@L[place.CategoryKey]</a>
                                <div class="listing-avatar">
                                    <a href="author-single.html"><img src="@(templateRoot)/images/avatar/1.jpg" alt=""></a>
                                    <span class="avatar-tooltip">@L["Landing:PostedBy"] <strong>KH HUB</strong></span>
                                </div>
                                <h3><a href="listing-single.html">@L[place.TitleKey]</a></h3>
                                <p>@L[place.DescriptionKey]</p>
                                <div class="geodir-category-options fl-wrap">
                                    <div class="listing-rating card-popup-rainingvis" data-starrating2="@place.Rating">
                                        <span>@L["Landing:ReviewsFormat", place.Reviews]</span>
                                    </div>
                                    <div class="geodir-category-location">
                                        <a href="#"><i class="fa fa-map-marker" aria-hidden="true"></i> @L[place.LocationKey]</a>
                                    </div>
                                </div>
                            </div>
                        </article>
                    </div>
                </div>
            }
        </div>
        <div class="swiper-button-prev sw-btn"><i class="fa fa-long-arrow-left"></i></div>
        <div class="swiper-button-next sw-btn"><i class="fa fa-long-arrow-right"></i></div>
    </div>
</section>
