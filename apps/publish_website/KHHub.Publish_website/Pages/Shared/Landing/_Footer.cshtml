@model KHHub.Publish_website.Pages.IndexModel

<footer class="footer-nine mt-5 py-5 border-top bg-white">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-4">
                <h5 class="mb-3">KH HUB</h5>
                <p class="text-muted mb-0">@L["Landing:FooterDescription"]</p>
            </div>
            <div class="col-6 col-lg-2">
                <h6 class="mb-3">@L["Landing:FooterExploreTitle"]</h6>
                <ul class="list-unstyled mb-0 d-grid gap-2">
                    <li><a class="text-decoration-none" href="#explore">@L["Landing:CtaExplore"]</a></li>
                    <li><a class="text-decoration-none" href="/">@L["Menu:Home"]</a></li>
                </ul>
            </div>
            <div class="col-6 col-lg-3">
                <h6 class="mb-3">@L["Landing:FooterSupportTitle"]</h6>
                <ul class="list-unstyled mb-0 d-grid gap-2">
                    <li class="text-muted">@L["Landing:FooterSupportHours"]</li>
                    <li><a class="text-decoration-none" href="mailto:info@khhub.vn">info@khhub.vn</a></li>
                </ul>
            </div>
            <div class="col-lg-3">
                <h6 class="mb-3">@L["Landing:FooterFollowTitle"]</h6>
                <p class="text-muted mb-0">@L["Landing:FooterFollowText"]</p>
            </div>
        </div>
    </div>
</footer>
