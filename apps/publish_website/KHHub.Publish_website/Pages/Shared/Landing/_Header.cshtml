@model object
@{
    var templateRoot = Url.Content("~/template");
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var currentPath = Context.Request.Path.Value ?? "/";
    var currentQuery = Context.Request.QueryString.Value ?? string.Empty;
    var returnUrl = currentPath + currentQuery;

    // Build language switch URLs that hit the SetLanguage handler so the choice is persisted via cookie.
    var viUrl = Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/set-language", new Dictionary<string, string?>
    {
        ["culture"] = "vi",
        ["returnUrl"] = returnUrl
    });
    var enUrl = Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/set-language", new Dictionary<string, string?>
    {
        ["culture"] = "en",
        ["returnUrl"] = returnUrl
    });

    // Resolve the active state for each top-level menu item based on the current request path.
    bool IsActive(string path, bool exact = false)
    {
        if (string.IsNullOrEmpty(path)) return false;
        if (exact)
        {
            return string.Equals(currentPath.TrimEnd('/'), path.TrimEnd('/'), StringComparison.OrdinalIgnoreCase);
        }
        return currentPath.StartsWith(path, StringComparison.OrdinalIgnoreCase);
    }

    string ActiveClass(bool isActive) => isActive ? "act-link" : string.Empty;
}

<header class="main-header dark-header fs-header sticky">
    <div class="header-inner">
        <div class="logo-holder">
            <a href="/"><img src="@(templateRoot)/images/khub-logo2-removebg-preview.png" alt="KH HUB"></a>
        </div>
        <div class="header-search vis-header-search">
            <div class="header-search-input-item">
                <input type="text" placeholder="@L["Landing:SearchKeywordPlaceholder"]" value="" />
            </div>
            <div class="header-search-select-item">
                <select data-placeholder="@L["Landing:AllCategories"]" class="chosen-select">
                    <option>@L["Landing:AllCategories"]</option>
                    <option>@L["Category:Shop"]</option>
                    <option>@L["Category:Hotel"]</option>
                    <option>@L["Category:Restaurant"]</option>
                    <option>@L["Category:Sports"]</option>
                    <option>@L["Category:Event"]</option>
                </select>
            </div>
            <button class="header-search-button" onclick="window.location.href='listing.html'">@L["Landing:Search"]</button>
        </div>
        <div class="show-search-button"><i class="fa fa-search"></i> <span>@L["Landing:Search"]</span></div>
        <details class="khhub-language-select" title="@L["Landing:SelectLanguage"]">
            <summary aria-label="@L["Landing:SelectLanguage"]">
                <i class="fa fa-globe"></i>
            </summary>
            <div class="khhub-language-select__menu">
                <a href="@viUrl" class="@(currentCulture == "vi" ? "is-active" : null)">🇻🇳 @L["Language:Vietnamese"]</a>
                <a href="@enUrl" class="@(currentCulture == "en" ? "is-active" : null)">🇺🇸 @L["Language:English"]</a>
            </div>
        </details>
        <div class="show-reg-form modal-open"><i class="fa fa-sign-in"></i>@L["Landing:SignIn"]</div>
        <div class="nav-button-wrap color-bg">
            <div class="nav-button">
                <span></span><span></span><span></span>
            </div>
        </div>
        <div class="nav-holder main-menu">
            <nav>
                <ul>
                    <li>
                        <a href="/" class="@ActiveClass(IsActive("/", exact: true))">@L["Menu:Home"] </a>
                    </li>
                    <li>
                        <a href="/places" class="@ActiveClass(IsActive("/places"))">@L["Menu:Places"]</a>
                    </li>
                    <li>
                        <a href="/news" class="@ActiveClass(IsActive("/news"))">@L["Menu:News"]</a>
                    </li>
                    <li>
                        <a href="/jobs" class="@ActiveClass(IsActive("/jobs"))">@L["Menu:Jobs"]</a>
                    </li>
                    <li>
                        <a href="/gold-price" class="@ActiveClass(IsActive("/gold-price"))">@L["Menu:GoldPrice"]</a>
                    </li>
                    <li>
                        <a href="#">@L["Menu:Pages"] <i class="fa fa-caret-down"></i></a>
                        <ul>
                            <li><a href="about.html">@L["Menu:About"]</a></li>
                            <li><a href="contacts.html">@L["Menu:Contact"]</a></li>
                            <li><a href="author-single.html">@L["Menu:Author"]</a></li>
                            <li><a href="how-itworks.html">@L["Menu:HowItWorks"]</a></li>
                            <li><a href="pricing-tables.html">@L["Menu:Pricing"]</a></li>
                            <li><a href="dashboard-myprofile.html">Dashboard</a></li>
                            <li><a href="blog-single.html">@L["Menu:NewsDetail"]</a></li>
                            <li><a href="dashboard-add-listing.html">@L["Menu:AddPlace"]</a></li>
                            <li><a href="404.html">404</a></li>
                            <li><a href="coming-soon.html">@L["Menu:ComingSoon"]</a></li>
                            <li><a href="header2.html">Header 2</a></li>
                            <li><a href="footer-fixed.html">Footer fixed</a></li>
                        </ul>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
</header>
