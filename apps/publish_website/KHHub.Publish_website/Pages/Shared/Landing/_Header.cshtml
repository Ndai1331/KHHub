@model KHHub.Publish_website.Pages.IndexModel
@{
    var templateRoot = Url.Content("~/template");
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}

<header class="main-header dark-header fs-header sticky">
    <div class="header-inner">
        <div class="logo-holder">
            <a href="/"><img src="@(templateRoot)/images/khub-logo2-removebg-preview.png" alt="KH HUB"></a>
        </div>
        <div class="header-search vis-header-search">
            <div class="header-search-input-item">
                <input type="text" placeholder="Từ khóa" value="" />
            </div>
            <div class="header-search-select-item">
                <select data-placeholder="Tất cả danh mục" class="chosen-select">
                    <option>Tất cả danh mục</option>
                    <option>Cửa hàng</option>
                    <option>Khách sạn</option>
                    <option>Nhà hàng</option>
                    <option>Thể thao</option>
                    <option>Sự kiện</option>
                </select>
            </div>
            <button class="header-search-button" onclick="window.location.href='listing.html'">Tìm kiếm</button>
        </div>
        <div class="show-search-button"><i class="fa fa-search"></i> <span>Tìm kiếm</span></div>
        <div class="khhub-language-select" title="@L["Landing:SelectLanguage"]">
            <i class="fa fa-globe"></i>
            <select id="khhub-language-select" aria-label="@L["Landing:SelectLanguage"]">
                @if (currentCulture == "vi")
                {
                    <option value="vi" selected>@L["Language:Vietnamese"]</option>
                    <option value="en">@L["Language:English"]</option>
                }
                else
                {
                    <option value="vi">@L["Language:Vietnamese"]</option>
                    <option value="en" selected>@L["Language:English"]</option>
                }
            </select>
        </div>
        <div class="show-reg-form modal-open"><i class="fa fa-sign-in"></i>Đăng nhập</div>
        <div class="nav-button-wrap color-bg">
            <div class="nav-button">
                <span></span><span></span><span></span>
            </div>
        </div>
        <div class="nav-holder main-menu">
            <nav>
                <ul>
                    <li>
                        <a href="/" class="act-link">Trang chủ <i class="fa fa-caret-down"></i></a>
