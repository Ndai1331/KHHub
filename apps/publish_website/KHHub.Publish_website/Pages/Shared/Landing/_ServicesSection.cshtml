@model KHHub.Publish_website.Pages.IndexModel

<section class="landing-section py-5">
    <div class="container">
        <div class="text-center mb-4">
            <h2 class="landing-section__title">@L["Landing:ServicesTitle"]</h2>
            <p class="landing-section__lead mb-0">@L["Landing:ServicesLead"]</p>
        </div>
        <div class="row g-4">
            <div class="col-6 col-lg-3">
                <article class="landing-service-card h-100">
                    <div class="landing-service-card__icon" aria-hidden="true"><i class="isax isax-airplane5"></i></div>
                    <h3 class="h6 mt-3">@L["Landing:ServiceFlightTitle"]</h3>
                    <p class="small text-muted mb-0">@L["Landing:ServiceFlightText"]</p>
                </article>
            </div>
            <div class="col-6 col-lg-3">
                <article class="landing-service-card h-100">
                    <div class="landing-service-card__icon" aria-hidden="true"><i class="isax isax-building-4"></i></div>
                    <h3 class="h6 mt-3">@L["Landing:ServiceHotelTitle"]</h3>
                    <p class="small text-muted mb-0">@L["Landing:ServiceHotelText"]</p>
                </article>
            </div>
            <div class="col-6 col-lg-3">
                <article class="landing-service-card h-100">
                    <div class="landing-service-card__icon" aria-hidden="true"><i class="isax isax-map5"></i></div>
                    <h3 class="h6 mt-3">@L["Landing:ServiceTourTitle"]</h3>
                    <p class="small text-muted mb-0">@L["Landing:ServiceTourText"]</p>
                </article>
            </div>
            <div class="col-6 col-lg-3">
                <article class="landing-service-card h-100">
                    <div class="landing-service-card__icon" aria-hidden="true"><i class="isax isax-car"></i></div>
                    <h3 class="h6 mt-3">@L["Landing:ServiceTransportTitle"]</h3>
                    <p class="small text-muted mb-0">@L["Landing:ServiceTransportText"]</p>
                </article>
            </div>
        </div>
    </div>
</section>
