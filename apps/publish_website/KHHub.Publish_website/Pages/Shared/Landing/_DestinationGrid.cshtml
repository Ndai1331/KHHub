@model KHHub.Publish_website.Pages.IndexModel

<section id="explore" class="landing-section landing-destinations py-5">
    <div class="container">
        <div class="row mb-4 align-items-end">
            <div class="col-lg-8">
                <h2 class="landing-section__title">@L["Landing:DestinationsTitle"]</h2>
                <p class="landing-section__lead text-muted mb-0">@L["Landing:DestinationsLead"]</p>
            </div>
        </div>

        @if (Model.Places.Count == 0)
        {
            <div class="abp-card border-0 shadow-sm">
                <div class="abp-card-body text-center py-5">
                    <p class="text-muted mb-3">@L["Landing:NoPlacesYet"]</p>
                </div>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var item in Model.Places)
                {
                    var p = item.Place;
                    var thumb = Model.ResolveMediaUrl(p.ThumbnailUrl ?? p.CoverImageUrl);
                    var placeUrl = $"/places/{p.Slug}";
                    <div class="col-md-6 col-xl-4">
                        <article class="landing-place-card abp-card h-100 border-0 shadow-sm">
                            <a class="landing-place-card__media-link" href="@placeUrl" aria-label="@p.Name">
                                @if (!string.IsNullOrEmpty(thumb))
                                {
                                    <img class="landing-place-card__img" src="@thumb" alt="@p.Name" loading="lazy" width="640" height="400" />
                                }
                                else
                                {
                                    <div class="landing-place-card__placeholder" role="img" aria-label="@p.Name"></div>
                                }
                            </a>
                            <div class="abp-card-body d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                    <h3 class="h5 mb-0">
                                        <a class="text-decoration-none text-dark" href="@placeUrl">@p.Name</a>
                                    </h3>
                                    @if (p.IsFeatured)
                                    {
                                        <span class="badge badge-landing-featured">@L["Landing:BadgeFeatured"]</span>
                                    }
                                </div>
                                @if (item.PlaceCategory != null)
                                {
                                    <span class="text-muted small mb-2">@item.PlaceCategory.Name</span>
                                }
                                @if (!string.IsNullOrEmpty(p.ShortDescription))
                                {
                                    <p class="text-muted small flex-grow-1 mb-3">@p.ShortDescription</p>
                                }
                                <div class="d-flex flex-wrap gap-3 small text-muted mt-auto">
                                    @if (p.RatingAveraged > 0)
                                    {
                                        <span>@L["Landing:Rating"]: @p.RatingAveraged.ToString("0.0")</span>
                                    }
                                    @if (!string.IsNullOrEmpty(p.Address))
                                    {
                                        <span class="text-truncate" style="max-width: 100%;" title="@p.Address">@p.Address</span>
                                    }
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </div>
</section>
