@{
    var templateRoot = Url.Content("~/template");
}

<footer class="main-footer dark-footer">
    <div class="container">
        <div class="row">
            <div class="col-md-3">
                <div class="footer-widget fl-wrap">
                    <h3>Về chúng tôi</h3>
                    <div class="footer-contacts-widget fl-wrap">
                        <p>KH HUB là nền tảng gợi ý và kết nối trải nghiệm du lịch, dịch vụ, địa điểm tại Khánh Hòa.</p>
                        <ul class="footer-contacts fl-wrap">
                            <li><span><i class="fa fa-envelope-o"></i> Email :</span><a href="mailto:contact@khhub.vn" target="_blank">contact@khhub.vn</a></li>
                            <li><span><i class="fa fa-map-marker"></i> Địa chỉ :</span><a href="#" target="_blank">Khánh Hòa, Việt Nam</a></li>
                            <li><span><i class="fa fa-phone"></i> Điện thoại :</span><a href="tel:+84000000000">+84 000 000 000</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="footer-widget fl-wrap">
                    <h3>Tin mới</h3>
                    <div class="widget-posts fl-wrap">
                        <ul>
                            <li class="clearfix">
                                <a href="#" class="widget-posts-img"><img src="@(templateRoot)/images/all/1.jpg" class="respimg" alt=""></a>
                                <div class="widget-posts-descr">
                                    <a href="#" title="">Gợi ý lịch trình cuối tuần</a>
                                    <span class="widget-posts-date"> 21 Mar 09.05 </span>
                                </div>
                            </li>
                            <li class="clearfix">
                                <a href="#" class="widget-posts-img"><img src="@(templateRoot)/images/all/1.jpg" class="respimg" alt=""></a>
                                <div class="widget-posts-descr">
                                    <a href="#" title="">Địa điểm mới tại Khánh Hòa</a>
                                    <span class="widget-posts-date"> 7 Mar 18.21 </span>
                                </div>
                            </li>
                            <li class="clearfix">
                                <a href="#" class="widget-posts-img"><img src="@(templateRoot)/images/all/1.jpg" class="respimg" alt=""></a>
