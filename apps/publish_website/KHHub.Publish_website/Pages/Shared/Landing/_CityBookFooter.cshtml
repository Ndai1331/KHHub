@{
    var templateRoot = Url.Content("~/template");
}

<footer class="main-footer dark-footer">
    <div class="container">
        <div class="row">
            <div class="col-md-3">
                <div class="footer-widget fl-wrap">
                    <h3>@L["Landing:FooterAboutTitle"]</h3>
                    <div class="footer-contacts-widget fl-wrap">
                        <p>@L["Landing:FooterAboutText"]</p>
                        <ul class="footer-contacts fl-wrap">
                            <li><span><i class="fa fa-envelope-o"></i> Email :</span><a href="mailto:contact@khhub.id.vn" target="_blank">contact@khhub.id.vn</a></li>
                            <li><span><i class="fa fa-map-marker"></i> @L["Landing:AddressLabel"] :</span><a href="#" target="_blank">@L["Location:KhanhHoaVietnam"]</a></li>
                            <li><span><i class="fa fa-phone"></i> @L["Landing:PhoneLabel"] :</span><a href="tel:+84000000000">+84 000 000 000</a></li>
                            <li><span><i class="fa fa-globe"></i> © KH HUB 2026. All rights reserved</span><a href="https://khhub.id.vn" target="_blank">https://khhub.id.vn</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="footer-widget fl-wrap">
                    <h3>@L["Landing:LatestNewsTitle"]</h3>
                    <div class="widget-posts fl-wrap">
                        <ul>
                            <li class="clearfix">
                                <a href="#" class="widget-posts-img"><img src="@(templateRoot)/images/all/1.jpg" class="respimg" alt=""></a>
                                <div class="widget-posts-descr">
                                    <a href="#" title="">@L["Landing:FooterNews1"]</a>
                                    <span class="widget-posts-date"> 21 Mar 09.05 </span>
                                </div>
                            </li>
                            <li class="clearfix">
                                <a href="#" class="widget-posts-img"><img src="@(templateRoot)/images/all/1.jpg" class="respimg" alt=""></a>
                                <div class="widget-posts-descr">
                                    <a href="#" title="">@L["Landing:FooterNews2"]</a>
                                    <span class="widget-posts-date"> 7 Mar 18.21 </span>
                                </div>
                            </li>
                            <li class="clearfix">
                                <a href="#" class="widget-posts-img"><img src="@(templateRoot)/images/all/1.jpg" class="respimg" alt=""></a>
                                <div class="widget-posts-descr">
                                    <a href="#" title="">@L["Landing:FooterNews3"]</a>
                                    <span class="widget-posts-date"> 7 Mar 16.42 </span>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="footer-widget fl-wrap">
                    <h3>@L["Landing:SocialChannelsTitle"]</h3>
                    <div id="footer-twiit"></div>

                    <div class="footer-social">
                        <ul>
                            <li><a href="#" target="_blank"><i class="fa fa-facebook-official"></i></a></li>
                            <li><a href="#" target="_blank"><i class="fa fa-twitter"></i></a></li>
                            <li><a href="#" target="_blank"><i class="fa fa-chrome"></i></a></li>
                            <li><a href="#" target="_blank"><i class="fa fa-vk"></i></a></li>
                            <li><a href="#" target="_blank"><i class="fa fa-whatsapp"></i></a></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="footer-widget fl-wrap">
                    <h3>@L["Landing:NewsletterTitle"]</h3>
                    <div class="subscribe-widget fl-wrap">
                        <p>@L["Landing:NewsletterLead"]</p>
                        <div class="subcribe-form">
                            <form id="subscribe">
                                <input class="enteremail" name="email" id="subscribe-email" placeholder="Email" spellcheck="false" type="text">
                                <button type="submit" id="subscribe-button" class="subscribe-button"><i class="fa fa-rss"></i> @L["Landing:Subscribe"]</button>
                                <label for="subscribe-email" class="subscribe-message"></label>
                            </form>
                        </div>
                    </div>
                    <div class="footer-widget fl-wrap">
                        <div class="footer-menu fl-wrap">
                            <ul>
                                <li><a href="/">@L["Menu:Home"]</a></li>
                                <li><a href="blog.html">@L["Menu:News"]</a></li>
                                <li><a href="listing.html">@L["Menu:Places"]</a></li>
                                <li><a href="contacts.html">@L["Menu:Contact"]</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
