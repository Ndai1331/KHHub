                    <div class="subscribe-widget fl-wrap">
                        <p>Nhận cập nhật mới nhất về điểm đến, sự kiện và trải nghiệm tại Khánh Hòa.</p>
                        <div class="subcribe-form">
                            <form id="subscribe">
                                <input class="enteremail" name="email" id="subscribe-email" placeholder="Email" spellcheck="false" type="text">
                                <button type="submit" id="subscribe-button" class="subscribe-button"><i class="fa fa-rss"></i> Đăng ký</button>
                                <label for="subscribe-email" class="subscribe-message"></label>
                            </form>
                        </div>
                    </div>
                    <div class="footer-widget fl-wrap">
                        <div class="footer-menu fl-wrap">
                            <ul>
                                <li><a href="/">Trang chủ</a></li>
                                <li><a href="blog.html">Tin tức</a></li>
                                <li><a href="listing.html">Địa điểm</a></li>
                                <li><a href="contacts.html">Liên hệ</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
